/* The icon of the setup launcher: runtime/spr.ico (tools/make_spr_icon.py) for SPR-Setup.exe, runtime/dkb.ico, the
   icon of the game executable, for the other setups. tools/make_release.py compiles this file with llvm-windres
   -I runtime, defining SPR_ICON for --game raiders, and links it with launcher.c. */
#ifdef SPR_ICON
1 ICON "spr.ico"
#else
1 ICON "dkb.ico"
#endif
